{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shopping Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "items"],
  "properties": {
    "format": { "const": "shopping-import" },
    "version": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "storeId": { "type": "string", "pattern": "^(heb|wholefoods|99ranch|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "item": {
      "type": "object",
      "required": ["name", "quantity", "note", "optional", "storePolicy"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
        "quantity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "unit"],
              "properties": {
                "value": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
              }
            }
          ]
        },
        "note": { "type": "string", "maxLength": 1000 },
        "optional": { "type": "boolean" },
        "storePolicy": {
          "type": "object",
          "required": ["mode", "storeIds"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["any", "preferred", "required"] },
            "storeIds": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/storeId" }
            }
          },
          "if": { "properties": { "mode": { "const": "any" } } },
          "then": { "properties": { "storeIds": { "maxItems": 0 } } },
          "else": { "properties": { "storeIds": { "minItems": 1 } } }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["manual", "chatgpt", "recipe"] },
            "ref": { "$ref": "#/$defs/reference" },
            "externalRef": { "$ref": "#/$defs/reference" }
          }
        },
        "externalRef": { "$ref": "#/$defs/reference" }
      }
    }
  }
}

